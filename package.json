{
  "name": "dsh-wechat-pad",
  "version": "0.2.0",
  "description": "Connect personal WeChat, through a self-hosted iPad-protocol backend, to DeepSeek Harness: reply in DMs and speak in groups only when mentioned.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/",
    "test/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "wechat",
    "weixin",
    "chatbot",
    "im",
    "experimental",
    "unofficial"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/bridge.test.mjs test/e2e.test.mjs test/settings.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "author": "QIC-9821",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIC-9821/dsh-wechat-pad.git"
  },
  "homepage": "https://github.com/QIC-9821/dsh-wechat-pad#readme",
  "bugs": {
    "url": "https://github.com/QIC-9821/dsh-wechat-pad/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
