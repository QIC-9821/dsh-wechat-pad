{
  "name": "dsh-wechat-pad",
  "version": "0.1.0",
  "description": "把个人微信（经 iPad 协议端）接进 DeepSeek Harness：私聊随手回，群里被 @ 才说话。Connect WeChat to DSH through a self-hosted iPad-protocol backend.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/",
    "test/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "wechat",
    "weixin",
    "chatbot",
    "im"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/bridge.test.mjs test/e2e.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
